(59)", "notes": [], "s": "Unisex and the house's best score. Notes not confirmed.", "w": ["everyday"]}, {"n": "Saheb Intense", "c": "2024", "img": "p_6e53ee", "d": "8.1 (91)", "notes": [], "s": "Notes and gender not confirmed.", "w": ["evening"]}, {"n": "Liwan", "c": "2024 · unisex", "img": "p_b92c9a", "d": "8.0 (145)", "notes": [], "s": "Unisex 2024 release. Notes not confirmed.", "w": ["everyday"]}, {"n": "Oud 24 Hours Majestic Gold", "c": "", "img": "p_09ecfa", "d": "8.0 (129)", "notes": [], "s": "Notes and gender not confirmed.", "w": ["evening"]}, {"n": "Satwa", "c": "2018", "img": "p_768e00", "d": "8.0 (104)", "notes": [], "s": "Labelled for men. Notes not confirmed.", "w": ["everyday"]}, {"n": "Tafakhar", "c": "gender not confirmed", "img": "p_fb5dc7", "d": "8.0 (53)", "notes": [], "s": "", "w": []}, {"n": "Wafa", "c": "gender not confirmed", "img": "p_5a20ca", "d": "7.9 (76)", "notes": [], "s": "", "w": []}, {"n": "Oud Muataq", "c": "gender not confirmed", "img": "p_998995", "d": "7.9 (62)", "notes": [], "s": "", "w": []}, {"n": "Oud Al Sayad", "c": "gender not confirmed", "img": "p_0affb9", "d": "7.8 (124)", "notes": [], "s": "", "w": []}, {"n": "Sheikh Al Oud", "c": "gender not confirmed", "img": "p_96f4e1", "d": "7.7 (73)", "notes": [], "s": "", "w": []}], "women": [{"n": "Mousuf", "c": "women", "img": "p_7b2b0d", "d": "8.0 (141)", "notes": [], "s": "The best-rated women's Ard Al Zaafaran. Notes not confirmed.", "w": ["everyday"]}, {"n": "Bint Hooran", "c": "women", "img": "p_afa228", "d": "8.0 (56)", "notes": [], "s": "Women's-labelled scent. Notes not confirmed.", "w": ["everyday"]}, {"n": "Shams Al Emarat Pink Blush", "c": "2025 · unisex", "img": "p_36b485", "d": "8.2 (59)", "notes": [], "s": "Unisex and the house's best score. Notes not confirmed.", "w": ["everyday"]}, {"n": "Liwan", "c": "2024 · unisex", "img": "p_b92c9a", "d": "8.0 (145)", "notes": [], "s": "Unisex 2024 release. Notes not confirmed.", "w": ["everyday"]}, {"n": "Midnight Oud", "c": "EDP · unisex", "img": "midnightoud", "d": "7.6 (636)", "notes": ["oregano", "pimento", "olibanum", "labdanum", "oud", "leather"], "s": "Spicy, balsamic and smoky oud, 6 to 8 hours. For evenings and winter.", "w": ["winter", "evening"]}]}, {"id": "reef", "name": "Reef", "tag": "Saudi · Oud", "src": [["Parfumo brand list", "https://www.parfumo.com/Perfumes/Reef"], ["The Scent Base: Reef 33", "https://thescentbase.com/perfumes/reef-perfumes/reef-33"], ["The Scent Base: Abaya Arabs", "https://thescentbase.com/perfumes/reef-perfumes/abaya-arabs"], ["Fragrantica (gender labels)", "https://www.fragrantica.com/"]], "note": "<b>Small numbers:</b> Reef's scents have fewer than 80 ratings each, so this order could easily change.", "men": [{"n": "Abaya", "c": "2024", "img": "p_c6e66e", "d": "8.8 (28)", "notes": [], "s": "Top score in the house, but only 28 ratings. Notes and gender not confirmed.", "w": ["evening"]}, {"n": "Reef 33", "c": "EDP", "img": "reef33", "d": "8.1 (74)", "notes": ["saffron", "rosemary", "oud"], "s": "A simple saffron-oud. Leans masculine, 6 to 10 hours.", "insp": "Similar to Gissah Imperial Valley", "w": ["evening", "winter"]}, {"n": "AlUla", "c": "unisex", "img": "p_a0d84e", "d": "8.7 (16)", "notes": [], "s": "Unisex. Only 16 ratings. Notes not confirmed.", "w": ["evening"]}, {"n": "Reef 21", "c": "unisex", "img": "p_93ca66", "d": "8.4 (23)", "notes": [], "s": "Unisex. Only 23 ratings. Notes not confirmed.", "w": ["everyday"]}, {"n": "Arab Obaya", "c": "Parfum", "img": "obaya", "d": "8.5 (11)", "notes": ["pineapple", "leather", "oud"], "s": "Fruity leather-oud. Very few ratings so far.", "w": ["evening"]}, {"n": "Reef 31", "c": "gender not confirmed", "img": "p_7a4435", "d": "8.3 (12)", "notes": [], "s": "", "w": []}, {"n": "Reef 33 White", "c": "unisex", "img": "p_f3af88", "d": "8.0 (36)", "notes": [], "s": "Unisex version of Reef 33. Notes not confirmed.", "w": ["everyday"]}, {"n": "Bluest", "c": "2024 · gender not confirmed", "img": "p_889f2b", "d": "8.3 (11)", "notes": [], "s": "", "w": []}, {"n": "Titan", "c": "2024 · unisex", "img": "p_dbba22", "d": "8.1 (18)", "notes": [], "s": "", "w": []}, {"n": "Pesca", "c": "2024 · unisex", "img": "p_b182b1", "d": "7.9 (27)", "notes": [], "s": "Unisex. Few ratings. Notes not confirmed.", "w": ["summer"]}], "women": [{"n": "AlUla", "c": "unisex", "img": "p_a0d84e", "d": "8.7 (16)", "notes": [], "s": "Unisex. Only 16 ratings. Notes not confirmed.", "w": ["evening"]}, {"n": "Reef 21", "c": "unisex", "img": "p_93ca66", "d": "8.4 (23)", "notes": [], "s": "Unisex. Only 23 ratings. Notes not confirmed.", "w": ["everyday"]}, {"n": "Reef 33 White", "c": "unisex", "img": "p_f3af88", "d": "8.0 (36)", "notes": [], "s": "Unisex version of Reef 33. Notes not confirmed.", "w": ["everyday"]}, {"n": "Titan", "c": "2024 · unisex", "img": "p_dbba22", "d": "8.1 (18)", "notes": [], "s": "", "w": []}, {"n": "Pesca", "c": "2024 · unisex", "img": "p_b182b1", "d": "7.9 (27)", "notes": [], "s": "Unisex. Few ratings. Notes not confirmed.", "w": ["summer"]}]}, {"id": "almajed", "name": "Al Majed Oud", "tag": "Kuwait · Small data", "src": [["Parfumo brand list", "https://www.parfumo.com/Perfumes/al-majed-oud"], ["Parfumo Serious review", "https://www.parfumo.com/Perfumes/al-majed-oud/serious/reviews/703565"], ["Fragrantica (gender labels)", "https://www.fragrantica.com/"]], "note": "<b>Small numbers:</b> only Serious has more than 25 ratings. No Al Majed scent is confirmed as women's or unisex, so the women's tab is empty.", "men": [{"n": "Serious", "c": "2026", "img": "serious", "d": "8.7 (79)", "notes": ["petitgrain", "bergamot", "ginger", "dark tea", "akigalawood"], "s": "Airy tea and woods with very long wear and strong sillage. Likely polarising.", "insp": "A reviewer compares it to Bois Impérial; a commenter disagrees", "w": ["office", "everyday"]}, {"n": "Prestige Ruby", "c": "", "img": "p_bd45b9", "d": "8.5 (22)", "notes": [], "s": "Only 22 ratings. Notes and gender not confirmed.", "w": ["evening"]}, {"n": "Noir", "c": "", "img": "p_358463", "d": "8.6 (15)", "notes": [], "s": "Only 15 ratings. Notes and gender not confirmed.", "w": ["evening"]}, {"n": "Elbrince", "c": "", "img": "p_1ccf5d", "d": "8.4 (14)", "notes": [], "s": "Only 14 ratings. Notes and gender not confirmed.", "w": ["evening"]}], "women": []}, {"id": "faan", "name": "Faan", "tag": "New house · Small data", "note": "<b>Too new to judge:</b> Faan's scents are mostly 2026 releases with about 10 ratings each, and none is confirmed as women's or unisex.", "src": [["Parfumo brand list", "https://www.parfumo.com/Perfumes/faan"], ["Fragrantica (gender labels)", "https://www.fragrantica.com/"]], "men": [{"n": "Honour", "c": "2026", "img": "honour", "d": "8.9 (10)", "notes": [], "s": "High score from only 7 ratings. Notes not confirmed.", "w": ["evening"]}, {"n": "Coral", "c": "2026", "img": "coral", "d": "8.6 (11)", "notes": [], "s": "The most-rated Faan scent, from just 11 ratings. Notes not confirmed.", "w": ["everyday"]}], "women": []}, {"id": "nicheemarati", "name": "Niche Emarati", "tag": "Lattafa sub-line", "note": "<b>Not rated separately:</b> Parfumo files Niche Emarati scents (Zikra, Al Dana, Hayaam, Durrah and others) under Lattafa, and their pages there didn't give reliable data. This house is left without picks rather than guessed.", "src": [["Parfumo: Lattafa", "https://www.parfumo.com/Perfumes/Lattafa"]], "men": [], "women": []}];

function buyUrl(b,f){const br=b.name.includes("/")?"":b.name.replace(/\(.*?\)/g,"").trim();const m=(f.c||"").match(/\b(EDP Intense|EDT Intense|EDP|EDT|Extrait|Parfum|Elixir|Cologne Intense|Cologne)\b/i);const q=[f.n.toLowerCase().startsWith(br.toLowerCase())?"":br,f.n,m?m[1]:"perfume"].filter(Boolean).join(" ");return "https://www.google.com/search?tbm=shop&q="+encodeURIComponent(q)}
const FAMC={floral:"#C27B93",amber:"#C87B2C"};
function sketch(fam){const c=FAMC[fam]||"#8E6440";return `<svg viewBox="0 0 60 90" role="img" aria-label="No photo available"><rect x="23" y="14" width="14" height="12" rx="2" fill="var(--cap)"/><rect x="25" y="26" width="10" height="6" fill="var(--glass)" stroke="var(--line)"/><rect x="12" y="32" width="36" height="52" rx="6" fill="${c}" opacity=".8" stroke="var(--line)"/></svg>`}
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
let G="men",query="";const openSet=new Set(["rayhaan"]);
const el=document.getElementById("brands");
function render(){
  const q=query.trim().toLowerCase();let shown=0;
  el.innerHTML=B.map(b=>{
    const list=b[G]||[];
    const items=list.map((f,i)=>({f,i})).filter(({f})=>!q||(b.name+" "+f.n+" "+f.notes.join(" ")+" "+(f.insp||"")+" "+f.s).toLowerCase().includes(q));
    if(!items.length&&(q||!b.note))return"";shown++;
    const open=!!q||openSet.has(b.id);
    return `<section class="brand${open?" open":""}" id="${b.id}">
    <button class="brand-head" aria-expanded="${open}" aria-controls="p-${b.id}" data-id="${b.id}">
      <span class="bname">${esc(b.name)}<span class="tag">${esc(b.tag)}</span></span>
      <span class="bmeta">${list.length?`Top ${G==="men"?"men's":"women's"} pick <b>${esc(list[0].n)}</b> · ${items.length} shown`:`No ${G==="men"?"men's":"women's"} picks with reliable data`}</span>
      <span class="chev" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg></span>
    </button>
    <div class="panel" id="p-${b.id}" ${open?"":"hidden"}>
      ${b.note?`<p class="note">${b.note}</p>`:""}
      ${items.map(({f,i})=>`<article class="card">
        <div class="bottle">${f.img&&PH[f.img]?`<img class="photo" src="${PH[f.img]}" alt="${esc(f.n)} bottle" width="200" height="200" loading="lazy">`:sketch(f.fam)}<span class="rank">No. ${i+1}</span></div>
        <div class="body">
          <h3 class="fname">${esc(f.n)}</h3>
          <div class="fmeta">${esc(f.c)}</div>
          <div class="row"><span class="data${/^No/.test(f.d)?" none":""}">${/^No/.test(f.d)?esc(f.d):"Parfumo "+esc(f.d)}</span><a class="buy" href="${buyUrl(b,f)}" target="_blank" rel="noopener" aria-label="Buy ${esc(f.n)} on Google Shopping (opens in a new tab)">Buy on Google <span aria-hidden="true">↗</span></a></div>
          ${f.insp?`<div class="insp">Inspired by: <b>${esc(f.insp)}</b></div>`:""}
          ${f.notes.length?`<div class="notes">${f.notes.map(n=>`<span>${esc(n)}</span>`).join("")}</div>`:(/not confirmed/i.test(f.s)?"":`<div class="nonotes">Notes not confirmed</div>`)}
          ${f.s?`<p class="says">${esc(f.s)}</p>`:""}
          ${f.w.length?`<div class="when">${f.w.map(w=>`<span>${OCC[w]}</span>`).join("")}</div>`:""}
        </div></article>`).join("")}
      <div class="sources">Sources: ${b.src.map(s=>`<a href="${s[1]}" target="_blank" rel="noopener">${esc(s[0])}</a>`).join("")}</div>
    </div></section>`}).join("");
  document.getElementById("empty").hidden=shown>0;
}
el.addEventListener("click",e=>{const h=e.target.closest(".brand-head");if(!h)return;const s=h.parentElement,p=s.querySelector(".panel"),o=p.hidden;p.hidden=!o;s.classList.toggle("open",o);h.setAttribute("aria-expanded",o);o?openSet.add(h.dataset.id):openSet.delete(h.dataset.id)});
document.querySelectorAll(".switch button").forEach(btn=>btn.addEventListener("click",()=>{G=btn.dataset.g;document.querySelectorAll(".switch button").forEach(x=>x.setAttribute("aria-pressed",x===btn));render()}));
const idx=document.getElementById("index");idx.innerHTML=B.map(b=>`<button data-id="${b.id}">${esc(b.name)}</button>`).join("");
idx.addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;openSet.add(b.dataset.id);render();const t=document.getElementById(b.dataset.id);if(t)t.scrollIntoView({behavior:matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth",block:"start"})});
document.getElementById("q").addEventListener("input",e=>{query=e.target.value;render()});
render();
</script>
