<title>Arabian Houses Shortlist</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,700;1,6..96,500&family=Figtree:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
/* Layout: same ledger as the designer shortlist; a Men / Women switch on top, one accordion row per house, numbered bottle cards inside. Warmer amber accent for the oud houses. */
:root{
  --bg:#F5F3EF; --surface:#FFFFFF; --ink:#1E1B17; --muted:#6A6258; --line:#E1DBD1;
  --accent:#8A4B12; --accent-soft:#F3E6D3; --glass:#EFE9DF; --cap:#2E2A25;
  --display:"Bodoni Moda","Didot","Bodoni 72",Georgia,serif;
  --body:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#15130F; --surface:#1E1B16; --ink:#ECE6DC; --muted:#A79D90; --line:#332E27;
  --accent:#E2A35A; --accent-soft:#3B2A17; --glass:#2A251F; --cap:#D3CABD; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#15130F; --surface:#1E1B16; --ink:#ECE6DC; --muted:#A79D90; --line:#332E27;
  --accent:#E2A35A; --accent-soft:#3B2A17; --glass:#2A251F; --cap:#D3CABD; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.55;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:28px 64px}
.wrap{max-width:880px;margin:0 auto;display:flex;flex-direction:column;gap:24px}
a{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
header{display:flex;flex-direction:column;gap:10px}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
h1{font-family:var(--display);font-weight:700;font-size:clamp(34px,7vw,56px);line-height:1.02;margin:0;text-wrap:balance}
h1 em{font-weight:500;font-style:italic;color:var(--accent)}
.lede{color:var(--muted);max-width:64ch;margin:0}
.switch{display:inline-flex;border:1px solid var(--line);border-radius:999px;background:var(--surface);padding:4px;gap:4px;align-self:flex-start}
.switch button{font:inherit;font-weight:600;border:0;background:transparent;color:var(--ink);padding:8px 20px;border-radius:999px;cursor:pointer}
.switch button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.search{display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.search input{flex:1;min-width:0;border:0;background:transparent;color:var(--ink);font:inherit;outline:none}
.search svg{flex:none;color:var(--muted)}
.index{display:flex;flex-wrap:wrap;gap:6px}
.index button{font-family:var(--display);font-size:15px;background:transparent;border:0;border-bottom:1px solid var(--line);color:var(--ink);padding:4px 2px;margin-right:8px;cursor:pointer}
.index button:hover{color:var(--accent);border-color:var(--accent)}
.brands{display:flex;flex-direction:column;border-top:1px solid var(--line)}
.brand{border-bottom:1px solid var(--line)}
.brand-head{width:100%;display:grid;grid-template-columns:1fr auto;gap:4px 16px;align-items:center;background:transparent;border:0;color:var(--ink);text-align:left;padding:18px 4px;cursor:pointer;font:inherit}
.brand-head:hover .bname{color:var(--accent)}
.bname{font-family:var(--display);font-size:clamp(22px,4.4vw,28px);font-weight:500;line-height:1.15}
.bmeta{grid-column:1;font-size:13px;color:var(--muted)}
.bmeta b{color:var(--ink);font-weight:600}
.tag{font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);background:var(--accent-soft);border-radius:4px;padding:2px 6px;margin-left:8px;vertical-align:middle;white-space:nowrap}
.chev{grid-row:1/span 2;grid-column:2;width:30px;height:30px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;transition:transform .2s}
.brand.open .chev{transform:rotate(180deg)}
.panel{display:flex;flex-direction:column;gap:12px;padding:0 0 24px}
.note{font-size:13px;color:var(--muted);background:var(--accent-soft);border-radius:8px;padding:10px 12px;margin:0}
.note b{color:var(--ink)}
.card{display:grid;grid-template-columns:96px 1fr;gap:16px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px}
.bottle{display:flex;flex-direction:column;align-items:center;gap:8px}
.bottle svg{width:64px;height:auto;max-width:100%}
.photo{width:96px;height:96px;max-width:100%;object-fit:contain;background:#FFFFFF;border-radius:10px;padding:4px;display:block}
.rank{font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:.06em}
.body{min-width:0;display:flex;flex-direction:column;gap:8px}
.fname{font-family:var(--display);font-size:21px;font-weight:700;margin:0;line-height:1.2;text-wrap:balance}
.fmeta{font-family:var(--mono);font-size:11.5px;color:var(--muted)}
.data{align-self:flex-start;font-size:12.5px;font-variant-numeric:tabular-nums;border:1px solid var(--line);border-radius:6px;padding:3px 8px}
.data.none{color:var(--muted);border-style:dashed}
.row{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.row .data{align-self:auto}
.buy{display:inline-flex;align-items:center;gap:4px;font-size:12.5px;font-weight:600;text-decoration:none;color:var(--bg);background:var(--ink);border-radius:999px;padding:4px 12px;line-height:1.4}
.buy:hover{background:var(--accent)}
.nonotes{font-size:12.5px;color:var(--muted);font-style:italic}
.insp{font-size:13px;color:var(--muted)}
.insp b{color:var(--ink);font-weight:600}
.notes{display:flex;flex-wrap:wrap;gap:5px}
.notes span{font-size:12px;background:var(--glass);border-radius:999px;padding:2px 9px}
.says{margin:0;font-size:14px}
.when{display:flex;flex-wrap:wrap;gap:5px}
.when span{font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;border:1px solid var(--line);border-radius:4px;padding:1px 6px}
.sources{font-size:12px;color:var(--muted)}
.sources a{margin-right:10px}
.empty{color:var(--muted);text-align:center;padding:28px 0}
footer{font-size:12.5px;color:var(--muted);border-top:1px solid var(--line);padding-top:16px;display:flex;flex-direction:column;gap:6px}
@media (max-width:480px){.card{grid-template-columns:72px 1fr;gap:12px;padding:14px}.photo{width:72px;height:72px}.bottle svg{width:48px}.fname{font-size:19px}}
@media (prefers-reduced-motion:reduce){.chev{transition:none}}
</style>

<div class="wrap">
  <header>
    <div class="eyebrow">Top 10 per tab · 23 houses · Middle Eastern perfumery</div>
    <h1>Arabian Houses <em>Shortlist</em></h1>
    <p class="lede">Switch between men's and women's picks, then tap a house. Each house shows up to ten per tab, ranked by Parfumo community score out of 10 (number of ratings in brackets). Scores from only a few ratings are pulled towards the average, so a 9.0 from 10 people doesn't outrank an 8.5 from 400. Gender labels come from Fragrantica. Women's tabs list women's scents first, then the best unisex ones, so the two tabs can overlap.</p>
  </header>
  <div class="switch" role="group" aria-label="Show picks for">
    <button id="tab-men" data-g="men" aria-pressed="true">Men</button>
    <button id="tab-women" data-g="women" aria-pressed="false">Women</button>
  </div>
  <label class="search" for="q">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
    <input id="q" type="search" placeholder="Search a fragrance, note or inspiration, e.g. Aventus, vanilla, oud" autocomplete="off">
  </label>
  <nav class="index" id="index" aria-label="Jump to a house"></nav>
  <div class="brands" id="brands"></div>
  <p class="empty" id="empty" hidden>Nothing matches that search. Try one note, such as "vanilla", or clear the box.</p>
  <footer>
    <span>Bottle photos and community ratings: <a href="https://www.parfumo.com" target="_blank" rel="noopener">Parfumo</a>. Notes and "inspired by" come from the review and retail sources listed under each house.</span>
    <span>"Inspired by" means reviewers or sellers compare it to that fragrance. These houses rarely confirm it themselves. Sample before buying a full bottle. "Buy on Google" opens a Google Shopping search in a new tab; check the seller before buying, as grey-market and fake bottles are common.</span>
  </footer>
</div>

<script>
const PH={"9pm": "data:image/webp;base64,", "9pmnight": "data:image/webp;base64,", "akoya": "data:image/webp;base64,", "amberempire": "data:image/webp;base64,", "aquatica": "data:image/webp;base64,", "eclaire": "data:image/webp;base64,", "feu": "data:image/webp;base64,", "hawaselixir": "data:image/webp;base64,", "herconf": "data:image/webp;base64,", "hisconf": "data:image/webp;base64,", "imperial": "data:image/webp;base64,", "italia": "data:image/webp;base64,", "jasmere": "data:image/webp;base64,", "kaaf": "data:image/webp;base64,", "khamrah": "data:image/webp;base64,", "kobra": "data:image/webp;base64,", "laathani": "data:image/webp;base64,", "laluna": "data:image/webp;base64,", "liam": "data:image/webp;base64,", "lion": "data:image/webp;base64,", "liquidbrun": "data:image/webp;base64,", "marj": "data:image/webp;base64,", "mavro": "data:image/webp;base64,", "pharaoh": "data:image/webp;base64,", "royalblend": "data:image/webp;base64,", "spectre": "data:image/webp;base64,", "summeroud": "data:image/webp;base64,", "supce": "data:image/webp;base64,", "supnoi": "data:image/webp;base64,", "teriaq": "data:image/webp;base64,", "terra": "data:image/webp;base64,", "turathi": "data:image/webp;base64,", "verde": "data:image/webp;base64,", "yara": "data:image/webp;base64,", "aogold": "data:image/webp;base64,", "aotobacco": "data:image/webp;base64,", "aqua": "data:image/webp;base64,", "cdnimle": "data:image/webp;base64,", "cdniw": "data:image/webp;base64,", "coral": "data:image/webp;base64,", "cremeclouds": "data:image/webp;base64,", "detour": "data:image/webp;base64,", "forbidden": "data:image/webp;base64,", "frenchtob": "data:image/webp;base64,", "hercules": "data:image/webp;base64,", "honour": "data:image/webp;base64,", "immortel": "data:image/webp;base64,", "imperium": "data:image/webp;base64,", "island": "data:image/webp;base64,", "jack": "data:image/webp;base64,", "junoon": "data:image/webp;base64,", "kalemat": "data:image/webp;base64,", "karus": "data:image/webp;base64,",