const B=[{"id": "rayhaan", "name": "Rayhaan", "tag": "UAE · Budget", "note": "<b>Women's tab:</b> Rayhaan makes almost no women's-labelled scents. Divine is the only one with enough ratings, so the rest of the tab is unisex. Tonquin Giza (7.5) misses both top 10s.", "src": [["Parfumo brand list", "https://www.parfumo.com/Perfumes/rayhaan"], ["Parfumo Terra review", "https://www.parfumo.com/Perfumes/rayhaan/terra/reviews/702064"], ["Parfumo Aquatica review", "https://www.parfumo.com/Perfumes/rayhaan/aquatica/reviews/692767"], ["The Scent Base: Lion", "https://thescentbase.com/perfumes/rayhaan/lion"], ["Kaufland: Italia", "https://www.kaufland.fr/product/550720757/"], ["Fragrantica (gender labels)", "https://www.fragrantica.com/"]], "men": [{"n": "Lion", "c": "EDP · 2024", "img": "lion", "d": "8.5 (222)", "notes": ["pear", "lavender", "mint", "cinnamon", "vanilla"], "s": "Sweet, loud and long-lasting. ScentVerdict calls it the Ultra Male clone to beat. Go easy on the sprays.", "insp": "JPG Ultra Male", "w": ["evening", "date"]}, {"n": "Aquatica", "c": "EDP · 2025 · unisex", "img": "aquatica", "d": "8.3 (914)", "notes": ["citrus", "coconut", "boozy accord", "creamy musk"], "s": "The brand's most-rated scent. Bright citrus and coconut that turns creamy and tropical. A reviewer rated sillage 10/10.", "w": ["summer", "everyday"]}, {"n": "Italia", "c": "EDP · 2025", "img": "italia", "d": "8.5 (173)", "notes": ["lavender", "bergamot", "honey", "cinnamon", "tobacco", "vanilla"], "s": "Fresh citrus opening into a honeyed, spicy tobacco base. 4.7/5 from 25 Kaufland buyers; one calls it slightly synthetic.", "w": ["everyday", "evening"]}, {"n": "Terra", "c": "EDP · 2025", "img": "terra", "d": "8.3 (623)", "notes": ["citrus", "resins", "incense", "soft oud"], "s": "A blended resin-and-incense scent where no note dominates. One reviewer scored scent 9.5, with moderate projection. Wearable beyond winter.", "insp": "Not a dupe, but fans of Ambre Sultan or Armaf Niche Oud may like i